        "emotion_ranges": {
          "patternProperties": {
            "^[a-z0-9]+(?:_[a-z0-9]+)*$": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
