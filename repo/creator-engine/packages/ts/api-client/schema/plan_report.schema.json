{
  "$defs": {
    "BehaviorCoverageReport": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/CoverageEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "stage": {
          "enum": [
            "predicted",
            "compiled",
            "observed"
          ],
          "title": "Stage",
          "type": "string"
        },
        "version_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Id"
        }
      },
      "required": [
        "stage"
      ],
      "title": "BehaviorCoverageReport",
      "type": "object"
    },
    "CompiledPart": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/CoverageLevel"
        },
        "method": {
          "$ref": "#/$defs/RealizationMethod"
        }
      },
      "required": [
        "level",
        "method"
      ],
      "title": "CompiledPart",
      "type": "object"
    },
    "CoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "approximation_executed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approximation Executed"
        },
        "character_key": {
          "title": "Character Key",
          "type": "string"
        },
        "compiled": {
          "$ref": "#/$defs/CompiledPart"
        },
        "dimension": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "title": "Dimension",
          "type": "string"
        },
        "expected_for_method": {
          "default": false,
          "title": "Expected For Method",
          "type": "boolean"
        },
        "item_ref": {
          "title": "Item Ref",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedPart"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested": {
          "title": "Requested",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "item_ref",
        "character_key",
        "dimension",
        "requested",
        "compiled"
      ],
      "title": "CoverageEntry",
      "type": "object"
    },
    "CoverageLevel": {
      "description": "Predicted execution of a requested behavior item (§10.3, §15.7).",
      "enum": [
        "HONORED",
        "APPROXIMATED",
        "UNSUPPORTED"
      ],
      "title": "CoverageLevel",
      "type": "string"
    },
    "EventTiming": {
      "additionalProperties": false,
      "description": "Where a behavior event lands on the timeline (estimated at planning, measured after previz);\nthe Performance Timeline places its markers here.",
      "properties": {
        "at_s": {
          "minimum": 0,
          "title": "At S",
          "type": "number"
        },
        "duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "end_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End S"
        },
        "event_key": {
          "title": "Event Key",
          "type": "string"
        },
        "scene_key": {
          "title": "Scene Key",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "scene_key",
        "event_key",
        "type",
        "at_s"
      ],
      "title": "EventTiming",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "additionalProperties": true,
          "title": "Detail",
          "type": "object"
        },
        "kind": {
          "enum": [
            "repetition",
            "contradiction",
            "fact_check",
            "policy",
            "timing",
            "world",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InputMode": {
      "enum": [
        "idea",
        "structured",
        "exact_script",
        "brain_dump"
      ],
      "title": "InputMode",
      "type": "string"
    },
    "ObservationVerdict": {
      "description": "What the analyzers saw (§16.3).",
      "enum": [
        "CONFIRMED",
        "PARTIAL",
        "NOT_OBSERVED",
        "CONTRADICTED",
        "NOT_MEASURABLE",
        "NOT_APPLICABLE"
      ],
      "title": "ObservationVerdict",
      "type": "string"
    },
    "ObservedPart": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "measures": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Measures",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/ObservationVerdict"
        }
      },
      "required": [
        "verdict"
      ],
      "title": "ObservedPart",
      "type": "object"
    },
    "Outcome": {
      "description": "The 12 viewer-level outcomes (§16.4). Only `*_CONFIRMED` counts as delivered (I9).",
      "enum": [
        "HONORED_CONFIRMED",
        "HONORED_PARTIAL",
        "HONORED_NOT_OBSERVED",
        "HONORED_CONTRADICTED",
        "APPROXIMATED_CONFIRMED",
        "APPROXIMATED_PARTIAL",
        "APPROXIMATED_NOT_OBSERVED",
        "APPROXIMATED_CONTRADICTED",
        "UNSUPPORTED",
        "UNSUPPORTED_OBSERVED",
        "NOT_MEASURABLE",
        "NOT_APPLICABLE"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "RealizationMethod": {
      "description": "Behavior compiler realization methods (§15.7).",
      "enum": [
        "native_parametric",
        "native_segment",
        "text_prompt_segment",
        "text_prompt_global",
        "shot_split",
        "prosody_transfer",
        "audio_nonverbal",
        "editorial_cutaway",
        "editorial_punch",
        "caption_emphasis",
        "music_cue",
        "sfx_cue",
        "keyframe_conditioning",
        "pose_guided",
        "post_expression",
        "omit"
      ],
      "title": "RealizationMethod",
      "type": "string"
    },
    "StateTiming": {
      "additionalProperties": false,
      "properties": {
        "drift_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drift S"
        },
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "requested_start_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Start S"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "state_key": {
          "title": "State Key",
          "type": "string"
        }
      },
      "required": [
        "state_key",
        "start_s",
        "end_s"
      ],
      "title": "StateTiming",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "cost_estimate_usd": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Estimate Usd"
    },
    "estimated_duration_s": {
      "minimum": 0,
      "title": "Estimated Duration S",
      "type": "number"
    },
    "event_timings": {
      "items": {
        "$ref": "#/$defs/EventTiming"
      },
      "title": "Event Timings",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input_mode": {
      "$ref": "#/$defs/InputMode"
    },
    "memory_items_used": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Memory Items Used",
      "type": "array"
    },
    "planner": {
      "default": "llm",
      "enum": [
        "llm",
        "template"
      ],
      "title": "Planner",
      "type": "string"
    },
    "predicted_coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/BehaviorCoverageReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "state_timings": {
      "items": {
        "$ref": "#/$defs/StateTiming"
      },
      "title": "State Timings",
      "type": "array"
    },
    "target_duration_s": {
      "minimum": 0,
      "title": "Target Duration S",
      "type": "number"
    },
    "timing_source": {
      "default": "estimated",
      "enum": [
        "estimated",
        "measured"
      ],
      "title": "Timing Source",
      "type": "string"
    },
    "version_id": {
      "format": "uuid",
      "title": "Version Id",
      "type": "string"
    }
  },
  "required": [
    "version_id",
    "input_mode",
    "estimated_duration_s",
    "target_duration_s"
  ],
  "title": "PlanReport",
  "type": "object"
}
