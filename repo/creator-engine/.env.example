# AI Creator Engine — environment variables (MASTER_BUILD_PROMPT §35).
# Dev-safe: `cp .env.example .env` gives a working `make dev`. Values that depend on the environment are
# left empty and resolve from config/env/<APP_ENV>.yaml. Production values are enforced by startup checks.
# Every variable is documented in docs/ENVIRONMENT_VARIABLES.md.
# URLs below target host processes (apps run on the host in early phases); Compose services override
# them with internal names (e.g. temporal:7233, http://seaweedfs:8333).

APP_ENV=dev
LOG_LEVEL=info
SECRET_KEY=dev-only-change-me
DATABASE_URL=postgresql+asyncpg://ce:ce_dev_password@localhost:5432/creator_engine
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ce-dev-access-key
S3_SECRET_ACCESS_KEY=ce-dev-secret-key
S3_BUCKET_ASSETS=ce-assets
S3_BUCKET_ARTIFACTS=ce-artifacts
# Not in §35 (D21, ADR 0030). Empty public endpoint = S3_ENDPOINT_URL. local_fs is the native fallback (dev/test only).
S3_PUBLIC_ENDPOINT_URL=
STORAGE_PROVIDER=s3
LOCAL_STORAGE_ROOT=./.data/storage
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
SCHEDULER_PUBLIC_URL=http://localhost:8100
SCHEDULER_INTERNAL_URL=http://localhost:8100
MOCK_GPU=true
MOCK_QC_FAIL_RATE=0.0
MOCK_TTS_MISREAD_RATE=0.0
MOCK_IMAGE_FACELESS_RATE=0.0
CPU_REAL_ENGINES=auto
LLM_PROVIDER=fixture
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
HF_TOKEN=
MODEL_CACHE_DIR=./.cache/models
RUNPOD_API_KEY=
VAST_API_KEY=
WORKER_TOKEN=
BUDGET_DAILY_USD=20
SMOKE_SPEND_CAP_USD=5
OPERATOR_JURISDICTION=EU
OPERATOR_REVENUE_BAND=lt_1m
PROVENANCE_MODE=
C2PA_SIGNING_CERT_PATH=
C2PA_SIGNING_KEY_PATH=
VISIBLE_LABEL_DEFAULT=auto
KMS_PROVIDER=local
KMS_LOCAL_KEY_PATH=
COOKIE_SECURE=
IDEMPOTENCY_TTL_S=86400
SSE_STREAM_RETENTION_S=86400
ENROLLMENT_TOKEN_TTL_S=3600
FIXTURE_CLIPS_DIR=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# --- Local infrastructure (Compose core profile; dev-only credentials) ---
POSTGRES_USER=ce
POSTGRES_PASSWORD=ce_dev_password
POSTGRES_DB=creator_engine
POSTGRES_PORT=5432
REDIS_PORT=6379
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
S3_PORT=8333
API_PORT=8000
WEB_PORT=3000
SEAWEED_MASTER_PORT=9333

# --- Observability (Compose observability profile, Phase 14; dev-only credentials) ---
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-password
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
OTEL_HTTP_PORT=4318
