    "change_state": "PUT /api/v0/instances/{id}/ {\"state\": \"running\"|\"stopped\"} -> {\"success\", \"msg\"?}",
    "create_instance": "PUT /api/v0/asks/{offer_id}/ -> {\"success\", \"new_contract\", \"instance_api_key\"?}",
    "current_user": "GET /api/v0/users/current (health; the body carries the account's api_key and is discarded)",
    "destroy_instance": "DELETE /api/v0/instances/{id}/ -> {\"success\", \"msg\"?}",
    "search_offers": "POST /api/v0/bundles/ -> {\"offers\": [...]}",
    "show_instance": "GET /api/v0/instances/{id}/?owner=me -> {\"instances\": {...} | null}"
